@model Member
@{
    ViewData["Title"] = "Add a member";
}

<div class="container py-4">
    <div class="card border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #D9A441 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="background-color: #2F4A3A; color: #F7F0E3; width: 46px; height: 46px; min-width: 46px;">+</div>
                <div>
                    <h2 class="h4 card-title fw-bold mb-0">Add a Member</h2>
                    <p class="text-muted small mb-0">Register a new patron in the library registry</p>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small">Full Name</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small">Email Address</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="MemberType" class="form-label fw-semibold small">Member Type</label>
                    <select asp-for="MemberType" class="form-select">
                        <option>Regular</option>
                        <option>Student</option>
                        <option>Faculty</option>
                    </select>
                    <span asp-validation-for="MemberType" class="text-danger small"></span>
                </div>
                <div class="d-flex align-items-center justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-link fw-semibold text-decoration-none px-3">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
