@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="p-4 mb-4 text-white rounded-3 shadow-sm" style="background-color: #0096C7;">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold mb-0">Library Registry</h1>
            <p class="mb-0 opacity-75">Currently tracking @Model.Count registered system patrons</p>
        </div>
        <a asp-action="Create" class="btn btn-light fw-semibold shadow-sm" style="color: #0096C7;">+ Add New Member</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="list-group list-group-flush">
        @foreach (var member in Model)
        {
            <div class="list-group-item p-3 border-start" style="border-left: 5px solid #0096C7 !important;">
                <div class="d-flex w-100 justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <!-- Fixed width layout spacer container to lock horizontal positioning -->
                        <div style="width: 3.5rem; flex-shrink: 0;">
                            <span class="badge rounded-pill bg-light text-dark border fw-bold text-center shadow-sm w-100">#@member.MemberId</span>
                        </div>
                        
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="background-color: #0096C7; width: 38px; height: 38px; min-width: 38px; flex-shrink: 0;">
                            @member.FullName.Substring(0, 1).ToUpper()
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold text-dark">@member.FullName</h5>
                            <span class="badge text-white me-2" style="background-color: #0096C7;">@member.MemberType</span>
                            <span class="text-muted small">Email: </span>
                            <span class="text-dark small fw-semibold">@(member.Email ?? "—")</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-secondary fw-semibold">✏️ Edit</a>
                        <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger">🗑️ Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
