@model List<Member>

@{
    ViewData["Title"] = "Members";
}

<div class="p-4 mb-4 text-white rounded-3" style="background-color: #2F4A3A;">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold mb-0 text-white">Library Registry</h1>
            <p class="mb-0" style="color: #D8E3D0;">Currently tracking @Model.Count registered system patrons</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-semibold">+ Add New Member</a>
    </div>
</div>

<div class="card border-0">
    <div class="list-group list-group-flush">
        @foreach (var member in Model)
        {
            <div class="list-group-item p-3 border-start" style="border-left: 5px solid #D9A441 !important; background-color: #FFFBF3;">
                <div class="d-flex w-100 justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 3.5rem; flex-shrink: 0;">
                            <span class="badge rounded-pill fw-bold text-center w-100" style="background-color: #EADFC9; color: #5A4434;">#@member.MemberId</span>
                        </div>

                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="background-color: #2F4A3A; color: #F7F0E3; width: 38px; height: 38px; min-width: 38px; flex-shrink: 0;">
                            @member.FullName.Substring(0, 1).ToUpper()
                        </div>

                        <div>
                            <h5 class="mb-1 fw-bold">@member.FullName</h5>
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <span class="badge" style="background-color: #E4ECDD; color: #2F4A3A;">@member.MemberType</span>
                                <span class="badge" style="background-color: #F6E2B8; color: #6B4510;">Books out: @member.OpenLoans</span>
                                <span class="text-muted small">Email: <span class="fw-semibold" style="color: #3A2A20;">@(member.Email ?? "—")</span></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-primary fw-semibold">Loans</a>
                        <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-secondary fw-semibold">Edit</a>
                        <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
