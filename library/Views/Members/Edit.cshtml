@model Member
@{
    ViewData["Title"] = "Edit a member";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #0096C7 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="background-color: #0096C7; width: 46px; height: 46px; min-width: 46px;">
                    <span class="fs-5 d-flex align-items-center justify-content-center">📝</span>
                </div>
                <div>
                    <h2 class="h4 card-title fw-bold text-dark mb-0">Modify Patron Membership</h2>
                    <p class="text-muted small mb-0">Updating record entry for Registry ID #@Model.MemberId</p>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="MemberId" />

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold text-secondary small">Full Name (Lastname, First Name)</label>
                    <input asp-for="FullName" class="form-control border-secondary-subtle" placeholder="e.g. Reyes, Ana" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary small">Email Address</label>
                    <input asp-for="Email" class="form-control border-secondary-subtle" type="email" placeholder="name@ub.edu.ph" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MemberType" class="form-label fw-semibold text-secondary small">Patron Account Type</label>
                    <select asp-for="MemberType" class="form-select border-secondary-subtle">
                        <option>Regular</option>
                        <option>Student</option>
                        <option>Faculty</option>
                    </select>
                    <span asp-validation-for="MemberType" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-link link-secondary fw-semibold text-decoration-none px-3">Cancel</a>
                    <button type="submit" class="btn text-white px-4 fw-semibold shadow-sm" style="background-color: #0096C7;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>