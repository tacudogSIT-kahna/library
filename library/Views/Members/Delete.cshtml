@model Member
@{
    ViewData["Title"] = "Delete a member";
}

<div class="container py-4">
    <div class="card border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #D9A441 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="background-color: #8A2F1E; color: #F7F0E3; width: 46px; height: 46px; min-width: 46px;">!</div>
                <div>
                    <h2 class="h4 card-title fw-bold mb-0">Revoke Patron Membership</h2>
                    <p class="text-muted small mb-0">Are you absolutely sure you want to delete this member registration record?</p>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <div class="rounded-3 p-3 mb-4" style="background-color: #F7F0E3; border: 1px solid #E6DAC3;">
                <div class="row g-2">
                    <div class="col-4 fw-semibold small" style="color: #5A4434;">Registry ID</div>
                    <div class="col-8 fw-bold">#@Model.MemberId</div>

                    <div class="col-4 fw-semibold small" style="color: #5A4434;">Full Name</div>
                    <div class="col-8">@Model.FullName</div>

                    <div class="col-4 fw-semibold small" style="color: #5A4434;">Patron Account Type</div>
                    <div class="col-8">
                        <span class="badge" style="background-color: #E4ECDD; color: #2F4A3A;">@Model.MemberType</span>
                    </div>

                    <div class="col-4 fw-semibold small" style="color: #5A4434;">Email Address</div>
                    <div class="col-8 text-truncate">@(Model.Email ?? "—")</div>
                </div>
            </div>

            <div class="alert border-0 p-3 mb-4 rounded-3 d-flex align-items-center gap-2" style="background-color: #F6E2B8; color: #6B4510;">
                <span class="small fw-medium">Safeguard Rule: Seeded database items tied to active legacy operations cannot be dropped via this screen panel.</span>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post" class="d-flex align-items-center justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-link fw-semibold text-decoration-none px-3">Cancel and Keep</a>
                <button type="submit" class="btn btn-danger px-4 fw-semibold">Confirm Deletion</button>
            </form>
        </div>
    </div>
</div>
