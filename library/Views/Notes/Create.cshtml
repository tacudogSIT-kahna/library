@model Note
@{
    ViewData["Title"] = "New Note";
}

<div class="container py-4">
    <div class="card border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #D9A441 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="background-color: #2F4A3A; color: #F7F0E3; width: 46px; height: 46px; min-width: 46px;">+</div>
                <div>
                    <h2 class="h4 card-title fw-bold mb-0">Add Library Note</h2>
                    <p class="text-muted small mb-0">Leave a reminder for the staff</p>
                </div>
            </div>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small">Note Title</label>
                    <input asp-for="Title" class="form-control" placeholder="Enter brief summary heading" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Body" class="form-label fw-semibold small">Details / Message Body</label>
                    <textarea asp-for="Body" class="form-control" rows="4" placeholder="Enter note details (optional)"></textarea>
                    <span asp-validation-for="Body" class="text-danger small"></span>
                </div>
                <div class="d-flex align-items-center justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-link fw-semibold text-decoration-none px-3">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Note</button>
                </div>
            </form>
        </div>
    </div>
</div>
