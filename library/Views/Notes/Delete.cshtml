@model Note
@{
    ViewData["Title"] = "Delete Note";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #0096C7 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="background-color: #ef233c; width: 46px; height: 46px; min-width: 46px;">
                    <span class="fs-5 d-flex align-items-center justify-content-center" style="line-height: 1; margin-top: -2px;">⚠️</span>
                </div>
                <div>
                    <h2 class="h4 card-title fw-bold text-dark mb-0">Discard Memo Record</h2>
                    <p class="text-muted small mb-0">Are you sure you want to drop this reminder tracking segment?</p>
                </div>
            </div>

            <div class="bg-light rounded-3 p-3 mb-4 border border-light">
                <div class="row g-2">
                    <div class="col-4 fw-semibold text-secondary small">Note ID</div>
                    <div class="col-8 text-dark fw-bold">#@Model.NoteId</div>
                    <div class="col-4 fw-semibold text-secondary small">Title</div>
                    <div class="col-8 text-dark">@Model.Title</div>
                    <div class="col-4 fw-semibold text-secondary small">Message</div>
                    <div class="col-8 text-secondary small">@(Model.Body ?? "—")</div>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.NoteId" method="post" class="d-flex align-items-center justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-link link-secondary fw-semibold text-decoration-none px-3">Cancel</a>
                <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">Confirm Deletion</button>
            </form>
        </div>
    </div>
</div>
