@model Note
@{
    ViewData["Title"] = "Delete Note";
}

<div class="container py-4">
    <div class="card border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #D9A441 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="background-color: #8A2F1E; color: #F7F0E3; width: 46px; height: 46px; min-width: 46px;">!</div>
                <div>
                    <h2 class="h4 card-title fw-bold mb-0">Discard Memo Record</h2>
                    <p class="text-muted small mb-0">Are you sure you want to drop this reminder tracking segment?</p>
                </div>
            </div>

            <div class="rounded-3 p-3 mb-4" style="background-color: #F7F0E3; border: 1px solid #E6DAC3;">
                <div class="row g-2">
                    <div class="col-4 fw-semibold small" style="color: #5A4434;">Note ID</div>
                    <div class="col-8 fw-bold">#@Model.NoteId</div>
                    <div class="col-4 fw-semibold small" style="color: #5A4434;">Title</div>
                    <div class="col-8">@Model.Title</div>
                    <div class="col-4 fw-semibold small" style="color: #5A4434;">Message</div>
                    <div class="col-8 small" style="color: #5A4434;">@(Model.Body ?? "—")</div>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.NoteId" method="post" class="d-flex align-items-center justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-link fw-semibold text-decoration-none px-3">Cancel</a>
                <button type="submit" class="btn btn-danger px-4 fw-semibold">Confirm Deletion</button>
            </form>
        </div>
    </div>
</div>
