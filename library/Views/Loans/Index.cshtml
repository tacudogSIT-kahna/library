@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<div class="p-4 mb-4 text-white rounded-3" style="background-color: #2F4A3A;">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold mb-0 text-white">Loans</h1>
            <p class="mb-0" style="color: #D8E3D0;">@Model.Count loans, newest first</p>
        </div>
        <a asp-action="Borrow" class="btn btn-primary fw-semibold">Borrow a book</a>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Member</th>
            <th>Book</th>
            <th>Loaned</th>
            <th>Due</th>
            <th>Status</th>
            <th style="width:7rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td class="fw-semibold">@loan.MemberName</td>
                <td>@loan.BookTitle</td>
                <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                <td>@(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</td>
                <td><span class="badge @(loan.Status == "Overdue" ? "text-bg-danger" : loan.Status == "Out" ? "text-bg-warning" : "text-bg-secondary")">@loan.Status</span></td>
                <td class="text-end">
                    @if (loan.ReturnedOn == null)
                    {
                        <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-success">Return</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
