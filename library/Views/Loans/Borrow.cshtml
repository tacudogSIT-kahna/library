@model BorrowForm
@{
    ViewData["Title"] = "Borrow a book";
}

<div class="container py-4">
    <div class="card border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #D9A441 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="background-color: #2F4A3A; color: #F7F0E3; width: 46px; height: 46px; min-width: 46px;">+</div>
                <div>
                    <h2 class="h4 card-title fw-bold mb-0">Borrow a book</h2>
                    <p class="text-muted small mb-0">Choose a member and a book to record a new loan</p>
                </div>
            </div>

            <form asp-action="Borrow" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="MemberId" class="form-label">Member</label>
                    <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                        <option value="">(choose a member)</option>
                    </select>
                    <span asp-validation-for="MemberId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BookId" class="form-label">Book</label>
                    <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                        <option value="">(choose a book)</option>
                    </select>
                    <span asp-validation-for="BookId" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DaysAllowed" class="form-label">Days allowed</label>
                    <input asp-for="DaysAllowed" class="form-control" />
                    <span asp-validation-for="DaysAllowed" class="text-danger"></span>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-link fw-semibold text-decoration-none px-3">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Borrow</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
