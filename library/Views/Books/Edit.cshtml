@model Book
@{
    ViewData["Title"] = "Edit a book";
}

<div class="container py-4">
    <div class="card border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #D9A441 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="background-color: #2F4A3A; color: #F7F0E3; width: 46px; height: 46px; min-width: 46px;">✎</div>
                <div>
                    <h2 class="h4 card-title fw-bold mb-0">Modify Book Details</h2>
                    <p class="text-muted small mb-0">Updating record entry for Book System ID #@Model.BookId</p>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="BookId" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small">Book Title</label>
                    <input asp-for="Title" class="form-control" placeholder="Enter book title" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-semibold small">Category / Classification</label>
                    <select asp-for="Category" class="form-select">
                        <option value="">(none)</option>
                        <option>Classic</option>
                        <option>Fiction</option>
                        <option>Poetry</option>
                        <option>Reference</option>
                        <option>Textbook</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Price" class="form-label fw-semibold small">Standard Price (PHP)</label>
                    <div class="input-group">
                        <span class="input-group-text text-muted" style="background-color: #EADFC9; border-color: #D9CBB0;">₱</span>
                        <input asp-for="Price" class="form-control" placeholder="0.00" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-link fw-semibold text-decoration-none px-3">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
