@model Book
@{
    ViewData["Title"] = "Edit a book";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #0096C7 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="background-color: #0096C7; width: 46px; height: 46px; min-width: 46px;">
                    <span class="fs-5 d-flex align-items-center justify-content-center">📝</span>
                </div>
                <div>
                    <h2 class="h4 card-title fw-bold text-dark mb-0">Modify Book Details</h2>
                    <p class="text-muted small mb-0">Updating record entry for Book System ID #@Model.BookId</p>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="BookId" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold text-secondary small">Book Title</label>
                    <input asp-for="Title" class="form-control border-secondary-subtle" placeholder="Enter book title" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-semibold text-secondary small">Category / Classification</label>
                    <select asp-for="Category" class="form-select border-secondary-subtle">
                        <option value="">(none)</option>
                        <option>Classic</option>
                        <option>Fiction</option>
                        <option>Poetry</option>
                        <option>Reference</option>
                        <option>Textbook</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Price" class="form-label fw-semibold text-secondary small">Standard Price (PHP)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-secondary-subtle text-muted">₱</span>
                        <input asp-for="Price" class="form-control border-secondary-subtle" placeholder="0.00" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-link link-secondary fw-semibold text-decoration-none px-3">Cancel</a>
                    <button type="submit" class="btn text-white px-4 fw-semibold shadow-sm" style="background-color: #0096C7;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
