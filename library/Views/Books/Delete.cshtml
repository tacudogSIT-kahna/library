@model Book
@{
    ViewData["Title"] = "Delete a book";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 38rem; border-top: 5px solid #0096C7 !important;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <!-- Fixed centered icon container -->
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="background-color: #ef233c; width: 46px; height: 46px; min-width: 46px;">
                    <span class="fs-5 d-flex align-items-center justify-content-center" style="line-height: 1; margin-top: -2px;">⚠️</span>
                </div>
                <div>
                    <h2 class="h4 card-title fw-bold text-dark mb-0">Remove Catalogue Item</h2>
                    <p class="text-muted small mb-0">Are you absolutely sure you want to delete this book record?</p>
                </div>
            </div>

            <div class="bg-light rounded-3 p-3 mb-4 border border-light">
                <div class="row g-2">
                    <div class="col-4 fw-semibold text-secondary small">System Index ID</div>
                    <div class="col-8 text-dark fw-bold">#@Model.BookId</div>
                    
                    <div class="col-4 fw-semibold text-secondary small">Book Title</div>
                    <div class="col-8 text-dark">@Model.Title</div>
                    
                    <div class="col-4 fw-semibold text-secondary small">Classification</div>
                    <div class="col-8">
                        <span class="badge text-white px-2.5 py-1.5" style="background-color: #0096C7;">@(Model.Category ?? "Unassigned")</span>
                    </div>
                    
                    <div class="col-4 fw-semibold text-secondary small">Standard Price</div>
                    <div class="col-8 text-dark fw-bold">@(Model.Price != null ? $"₱{Model.Price?.ToString("N2")}" : "—")</div>
                </div>
            </div>

            <div class="alert alert-warning border-0 p-3 mb-4 rounded-3 d-flex align-items-center gap-2" style="background-color: rgba(0, 150, 199, 0.08); color: #0077b6;">
                <span class="small fw-medium">💡 Heads up: Any ongoing loan agreements linked to this copy will be scrubbed automatically from database records.</span>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.BookId" method="post" class="d-flex align-items-center justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-link link-secondary fw-semibold text-decoration-none px-3">Cancel and Keep</a>
                <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">Confirm Deletion</button>
            </form>
        </div>
    </div>
</div>
