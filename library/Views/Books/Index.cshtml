@model List<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="p-4 mb-4 text-white rounded-3 shadow-sm" style="background-color: #0096C7;">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold mb-0">Library Catalogue</h1>
            <p class="mb-0 opacity-75">Currently tracking @Model.Count books in the database system</p>
        </div>
        <a asp-action="Create" class="btn btn-light fw-semibold shadow-sm" style="color: #0096C7;">+ Add New Book</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="list-group list-group-flush">
        @foreach (var book in Model)
        {
            <div class="list-group-item p-3 border-start" style="border-left: 5px solid #0096C7 !important;">
                <div class="d-flex w-100 justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <!-- Fixed width layout spacer container to lock horizontal positioning -->
                        <div style="width: 3.5rem; flex-shrink: 0;">
                            <span class="badge rounded-pill bg-light text-dark border fw-bold text-center shadow-sm w-100">#@book.BookId</span>
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold text-dark">@book.Title</h5>
                            <span class="badge text-white me-2" style="background-color: #0096C7;">@(book.Category ?? "Unassigned")</span>
                            <span class="text-muted small">Price: </span>
                            <span class="fw-semibold text-dark small">@(book.Price != null ? $"₱{book.Price?.ToString("N2")}" : "—")</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-secondary fw-semibold">✏️ Edit</a>
                        <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger">🗑️ Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
