@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 rounded-3 text-center" style="background-color: #2F4A3A;">
    <h1 class="display-5 fw-bold text-white">Welcome to the Library</h1>
    <p class="lead mb-4" style="color: #D8E3D0;">Manage the catalogue, register patrons, track loans and keep staff notes, all in one quiet corner.</p>
    <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg">Browse the catalogue</a>
</div>

<div class="row g-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 h-100" style="border-top: 5px solid #D9A441 !important;">
            <div class="card-body p-4">
                <h2 class="h5 mb-2">Books</h2>
                <p class="text-muted small">Browse, add and update every title on the shelves.</p>
                <a asp-controller="Books" asp-action="Index" class="btn btn-sm btn-outline-secondary fw-semibold">Open books</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 h-100" style="border-top: 5px solid #D9A441 !important;">
            <div class="card-body p-4">
                <h2 class="h5 mb-2">Members</h2>
                <p class="text-muted small">Keep the registry of students, faculty and regular patrons.</p>
                <a asp-controller="Members" asp-action="Index" class="btn btn-sm btn-outline-secondary fw-semibold">Open members</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 h-100" style="border-top: 5px solid #D9A441 !important;">
            <div class="card-body p-4">
                <h2 class="h5 mb-2">Loans</h2>
                <p class="text-muted small">Lend books out, see what is overdue and record returns.</p>
                <a asp-controller="Loans" asp-action="Index" class="btn btn-sm btn-outline-secondary fw-semibold">Open loans</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 h-100" style="border-top: 5px solid #D9A441 !important;">
            <div class="card-body p-4">
                <h2 class="h5 mb-2">Notepad</h2>
                <p class="text-muted small">Jot down reminders and operation logs for the staff.</p>
                <a asp-controller="Notes" asp-action="Index" class="btn btn-sm btn-outline-secondary fw-semibold">Open notepad</a>
            </div>
        </div>
    </div>
</div>